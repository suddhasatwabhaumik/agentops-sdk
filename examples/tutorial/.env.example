# Copy to .env (git-ignored) and fill in. Every tutorial loads this file before running.

# --- GCP project and region ---
GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>
GOOGLE_CLOUD_LOCATION=europe-west4
ENVIRONMENT=dev

# --- Telemetry: traces, metrics and logs -> local OTLP collector (Alloy in examples/full_stack) ---
AGENTOPS_TELEMETRY_MODE=otlp
OTEL_COLLECTOR_URL=http://localhost:4317
OTEL_SERVICE_NAME=agentops-tutorial
TEMPO_URL=http://localhost:3200
PROMETHEUS_URL=http://localhost:9090

# --- LLM (real Gemini on Vertex AI) ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LOCATION=europe-west4

# --- BigQuery (02 case telemetry, 05 sql guard, 06 RLS, 14 audit ledger, 15 feature store) ---
TUTORIAL_BQ_DATASET=agentops_tutorial

# --- Model Armor (09). Fail-closed is enabled by default in SDK v1 ---
MODEL_ARMOR_LOCATION=europe-west4
MODEL_ARMOR_INPUT_TEMPLATE=agentops-input-guard
MODEL_ARMOR_OUTPUT_TEMPLATE=agentops-output-guard
MODEL_ARMOR_FAIL_CLOSED=true

# --- Memory (12). Cloud SQL reached through Cloud SQL Auth Proxy ---
DATABASE_URL=postgresql+psycopg2://agentops:CHANGE_ME@127.0.0.1:5434/agentops
MEMORY_BANK_NAME=projects/PROJECT_NUMBER/locations/europe-west4/reasoningEngines/ENGINE_ID
MEMORY_BANK_LOCATION=europe-west4

# --- Prompt registry (11): Vertex AI Prompt Management ---
PROMPT_REGISTRY_BACKEND=vertex_ai
PROMPT_REGISTRY_LOCATION=europe-west4
PROMPT_REGISTRY_FALLBACK_TO_LOCAL=false

# --- Feature store (15) ---
TUTORIAL_ONLINE_STORE_ID=agentops_tutorial_online_store
TUTORIAL_FEATURE_VIEW_ID=tenant_features_view
