    {
      "type": "stat",
      "title": "LLM tokens",
      "description": "Sum of llm.input_tokens + llm.output_tokens over FinOps records.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=\"$service\", service_instance_id=~\"$instance\"} | ingest_path=~\"$ingest_path\" | event_type=\"finops_llm_telemetry\" | unwrap llm_input_tokens [$__range])) + sum(sum_over_time({service_name=\"$service\", service_instance_id=~\"$instance\"} | ingest_path=~\"$ingest_path\" | event_type=\"finops_llm_telemetry\" | unwrap llm_output_tokens [$__range]))",
          "legendFormat": "",
