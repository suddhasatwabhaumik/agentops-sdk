{
  "uid": "agentops-sdk-overview",
  "title": "AgentOps SDK - Overview",
  "description": "Spans, metrics and FinOps logs emitted by the AgentOps SDK.",
  "tags": [
    "agentops",
    "sdk"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "timepicker": {},
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "textbox",
        "query": "agentops-full-stack-demo",
        "current": {
          "text": "agentops-full-stack-demo",
          "value": "agentops-full-stack-demo"
        }
      },
      {
        "name": "ingest_path",
        "label": "Ingest path",
        "type": "custom",
        "query": "alloy,otel-collector",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "instance",
        "label": "Run (service.instance.id)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(agentops_rate_limit_requests_total{ingest_path=~\"$ingest_path\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(agentops_rate_limit_requests_total{ingest_path=~\"$ingest_path\"}, instance)",
        "refresh": 2,
        "sort": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "AgentOps dashboards",
      "type": "dashboards",
      "tags": [
        "agentops"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Telemetry emitted by the **AgentOps SDK** from `examples/full_stack/run_full_stack.py`. **SDK metrics** (rate limiter, prompt registry) are filtered by run and ingest path. **Agent flow** panels come from span metrics that Tempo derives from the SDK's spans, so they ignore the run filter. **FinOps** panels are computed in Loki from the records `@trace_llm_call` writes, because the SDK emits token usage as logs and not as metrics."
      },
      "transparent": true,
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "row",
      "title": "At a glance",
      "collapsed": false,
      "id": 2,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Agent flows",
      "description": "agent_flow:* spans from @trace_agent_flow (Tempo span metrics).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(traces_spanmetrics_calls_total{service=\"$service\", ingest_path=~\"$ingest_path\", span_name=~\"agent_flow:.*\"}[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      }
    },
